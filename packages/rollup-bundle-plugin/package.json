{
  "name": "@pandino/rollup-bundle-plugin",
  "version": "0.1.0",
  "description": "Rollup/Vite plugin for Pandino to generate a BundleModule from decorators",
  "license": "EPL-2.0",
  "author": "Norbert Herczeg <norbert.herczeg@blackbelt.hu>",
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "picomatch": "^4.0.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/picomatch": "^4.0.3",
    "rollup": "^4.60.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "rollup": ">=3",
    "vite": ">=4"
  }
}
