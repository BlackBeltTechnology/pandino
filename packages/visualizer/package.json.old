{
  "name": "@pandino/visualizer",
  "version": "0.1.0",
  "description": "Real-time visualizer for Pandino framework - services, bundles, and configurations",
  "license": "EPL-2.0",
  "author": "Norbert Herczeg <norbert.herczeg@blackbelt.hu>",
  "type": "module",
  "main": "dist/pandino-visualizer.js",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "demo": "http-server -p 8080 -c-1 -o demo.html",
    "start": "http-server -p 8080 -c-1"
  },
  "devDependencies": {
    "@pandino/pandino": "workspace:*",
    "http-server": "^14.1.1",
    "typescript": "^5.9.2",
    "vite": "^6.0.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}

