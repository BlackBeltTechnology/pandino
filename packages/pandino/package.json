{
  "name": "@pandino/pandino",
  "version": "0.9.20",
  "description": "A TypeScript implementation of the OSGi specification.",
  "license": "EPL-2.0",
  "author": "Norbert Herczeg <norbert.herczeg@blackbelt.hu>",
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/pandino.cjs.js",
  "module": "dist/pandino.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pandino.esm.js",
      "require": "./dist/pandino.cjs.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "check:fix": "oxlint --fix ./src && oxfmt --write ./src"
  },
  "dependencies": {
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/picomatch": "^4.0.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@pandino/decorators": "workspace:*",
    "reflect-metadata": "^0.2.2"
  }
}
