{
  "name": "@pandino/decorators",
  "version": "0.9.20",
  "description": "Decorators for the Pandino framework.",
  "license": "EPL-2.0",
  "author": "Norbert Herczeg <norbert.herczeg@blackbelt.hu>",
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/decorators.cjs.js",
  "module": "dist/decorators.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/decorators.esm.js",
      "require": "./dist/decorators.cjs.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development",
    "prepublishOnly": "pnpm build",
    "check:fix": "oxlint --fix ./src && oxfmt --write ./src"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
