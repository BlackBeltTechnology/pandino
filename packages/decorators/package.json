{
    "name": "@pandino/decorators",
    "version": "0.9.20",
    "description": "Decorators for the Pandino framework.",
    "license": "EPL-2.0",
    "author": "Norbert Herczeg <norbert.herczeg@blackbelt.hu>",
    "main": "dist/decorators.cjs.js",
    "module": "dist/decorators.es.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/decorators.es.js",
            "require": "./dist/decorators.cjs.js"
        }
    },
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "tsc && vite build",
        "build:dev": "tsc && vite build --mode development",
        "prepublishOnly": "pnpm build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest --coverage",
        "test:ui": "vitest --ui",
        "check:fix": "biome check ./src --write"
    },
    "peerDependencies": {
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@types/node": "^20.19.9",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "http-server": "^14.1.1",
        "jsdom": "^26.1.0",
        "typescript": "^5.9.2",
        "vite": "^7.0.6",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    }
}
