{
    "name": "@pandino/react-hooks",
    "version": "0.9.20",
    "description": "React hooks and components for Pandino framework",
    "license": "EPL-2.0",
    "author": "Norbert Herczeg <norbert.herczeg@blackbelt.hu>",
    "main": "dist/react-hooks.cjs.js",
    "module": "dist/react-hooks.es.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/react-hooks.es.js",
            "require": "./dist/react-hooks.cjs.js"
        }
    },
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "tsc && vite build",
        "build:dev": "tsc && vite build --mode development",
        "prepublishOnly": "pnpm build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest --coverage",
        "test:ui": "vitest --ui",
        "check:fix": "biome check ./src --write"
    },
    "peerDependencies": {
        "@pandino/pandino": "workspace:*",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.6.4",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^24.2.0",
        "@types/react": "^19.1.9",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "jsdom": "^26.1.0",
        "typescript": "^5.9.2",
        "vite": "^7.0.6",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    }
}
